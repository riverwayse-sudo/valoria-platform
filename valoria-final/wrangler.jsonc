{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-assessment",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/valu/assessment*",
      "/remaining*",
      "/assets/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
      "VALU_PREVIEW": "1",
      "VALU_STAGING_API_ENABLED": "1",
      "VALU_PREVIEW_SITE_ORIGIN": "https://staging.valoriainstitute.com",
      "VALU_PREVIEW_ASSESSMENT_ORIGIN": "https://assessment-staging.valoriainstitute.com",
      "VALORIA_SITE_URL": "https://staging.valoriainstitute.com"
    }
  },
  "env": {
    "staging": {
      "name": "valoria-staging-assessment",
      "vars": {
        "SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
        "VALU_PREVIEW": "1",
        "VALU_STAGING_API_ENABLED": "1",
        "VALU_PREVIEW_SITE_ORIGIN": "https://staging.valoriainstitute.com",
        "VALU_PREVIEW_ASSESSMENT_ORIGIN": "https://assessment-staging.valoriainstitute.com",
        "VALORIA_SITE_URL": "https://staging.valoriainstitute.com"
      }
    }
  }
}
