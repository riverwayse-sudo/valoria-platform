{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-assessment",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/valu/assessment", "/valu/assessment/*"]
  },
  "triggers": {
    "crons": ["0 2 * * *", "0 3 * * *"]
  },
  "observability": { "enabled": true },
  "previews": {
    "vars": {
      "VALU_PREVIEW": "1",
      "VALU_PRODUCTION_SUPABASE_URL": "https://sbkgpisgkuhbalsxqkdr.supabase.co"
    }
  }
}
