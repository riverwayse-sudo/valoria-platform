{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-assessment",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/valu/assessment*",
      "/remaining*",
      "/assets/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "valoria-staging-assessment",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/api/*",
          "/valu/assessment*",
          "/remaining*",
          "/assets/*"
        ]
      },
      "vars": {
        "SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
        "VALU_PRODUCTION_SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
        "VALU_PREVIEW": "1",
        "VALU_STAGING_API_ENABLED": "0"
      },
      "previews": {
        "vars": {
          "SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
          "VALU_PRODUCTION_SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
          "VALU_PREVIEW": "1",
          "VALU_STAGING_API_ENABLED": "0"
        }
      }
    }
  }
}
