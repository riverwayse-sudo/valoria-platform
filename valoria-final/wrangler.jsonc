{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-assessment",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/valu/assessment*",
      "/assets/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
