# Client (Vite — safe to expose, these are the anon key/URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — set these in Vercel project settings, never commit real values.
# SUPABASE_URL should be the same project URL as VITE_SUPABASE_URL above.
SUPABASE_URL=
# Used by claim-listing.js to verify the caller's access token against
# /auth/v1/user. Without it that route silently falls back to the service-role
# key, so the check runs with more privilege than the request needs.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Public origin of the valoria-site deployment this platform belongs to.
# Used for auth redirects (create-account, resend-confirmation) and journey
# links (assessment-progress). Resolution order in lib/site-url.js:
# VALORIA_SITE_URL -> SITE_ORIGIN -> NEXT_PUBLIC_SITE_URL -> production.
#
# Set this on staging to the staging site origin. If it is left unset on a
# non-production deployment, confirmation emails and reminders point at
# production: the account is created in the staging database but confirmed on
# the production site, and the participant is stranded. The resolver logs an
# error naming this variable when that happens.
#
# Deliberately not VERCEL_URL: the platform and the site are separate Vercel
# projects, so VERCEL_URL names this deployment, not the site.
#
# Also read at BUILD time by vite.config.js, which inlines it into the
# assessment bundle as the base for the app's outbound links (sign in, sign up,
# journey continuation, report, profile setup). Those links were hardcoded to
# production, so on staging the assessment handed the participant back to the
# production site. It must be set for the build environment, not only at runtime.
VALORIA_SITE_URL=

# --- Environment write guard (lib/environment-guard.js) ---
# The guard decides whether this deployment may perform a privileged Supabase
# write. It requires the runtime AND the target database to be positively
# identified, so nothing is allowed by default.
#
# On Vercel, VERCEL_ENV is provided automatically. Set exactly one of the two
# project refs below per scope (the 20-character ref from the Supabase project
# URL, e.g. abcdefghijklmnopqrst in https://abcdefghijklmnopqrst.supabase.co):
#   Production scope -> PRODUCTION_SUPABASE_PROJECT_REF
#   Preview scope    -> STAGING_SUPABASE_PROJECT_REF
#
# Until the matching ref is set, a privileged write from that scope is refused
# with HTTP 503 rather than silently reaching the wrong database. That is the
# intended fail-closed behaviour.
PRODUCTION_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_PROJECT_REF=

# Local development and the test runner only. Vercel never sets this. When the
# runtime is unidentified (VERCEL_ENV unset) a privileged write is refused unless
# this is exactly "true", and even then the target must still match the declared
# staging project. Do not set this on a deployed environment.
ALLOW_LOCAL_PRIVILEGED_WRITES=
