# Client (Vite — safe to expose, these are the anon key/URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — set these in Vercel project settings, never commit real values.
# SUPABASE_URL should be the same project URL as VITE_SUPABASE_URL above.
SUPABASE_URL=
# Used by claim-listing.js to verify the caller's access token against
# /auth/v1/user. Without it that route silently falls back to the service-role
# key, so the check runs with more privilege than the request needs.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Public origin of the valoria-site deployment this platform belongs to.
# Used for auth redirects (create-account, resend-confirmation) and journey
# links (assessment-progress). Resolution order in lib/site-url.js:
# VALORIA_SITE_URL -> SITE_ORIGIN -> NEXT_PUBLIC_SITE_URL -> production.
#
# Set this on staging to the staging site origin. If it is left unset on a
# non-production deployment, confirmation emails and reminders point at
# production: the account is created in the staging database but confirmed on
# the production site, and the participant is stranded. The resolver logs an
# error naming this variable when that happens.
#
# Deliberately not VERCEL_URL: the platform and the site are separate Vercel
# projects, so VERCEL_URL names this deployment, not the site.
VALORIA_SITE_URL=
