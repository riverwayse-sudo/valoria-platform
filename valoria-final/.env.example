# Client (Vite — safe to expose, these are the anon key/URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — set these in Vercel project settings, never commit real values.
# SUPABASE_URL should be the same project URL as VITE_SUPABASE_URL above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Server-only canonical site origin used by assessment reminder emails.
# For preview deployments, set this to the paired site preview origin; never production.
VALU_SITE_ORIGIN=https://valoriainstitute.com
